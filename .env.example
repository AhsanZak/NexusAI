# Local development defaults. Copy to .env when you need to override them.
# Never commit .env. The values below are local placeholders, not production secrets.

NEXUS_ENVIRONMENT=local
NEXUS_LOG_LEVEL=INFO
NEXUS_DATABASE_URL=postgresql+asyncpg://nexus:nexus@postgres:5432/nexusai
NEXUS_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
NEXUS_CHAT_ALIAS=ollama-qwen3.8
# ollama/ prefix calls the GPU Ollama server directly. The key is not sent there.
NEXUS_CHAT_MODEL=ollama/qwen3.8:27b
NEXUS_CHAT_API_BASE=http://192.168.100.11:11434
NEXUS_OLLAMA_BASE_URL=http://192.168.100.11:11434
NEXUS_OLLAMA_CHAT_MODEL=qwen3.8:27b
NEXUS_OLLAMA_INTENT_MODEL=qwen3:8b
NEXUS_OLLAMA_EMBED_MODEL=bge-m3:latest
NEXUS_LLM_TIMEOUT_SECONDS=180
NEXUS_LLM_MAX_RETRIES=2
NEXUS_TRACE_DATABASE_URL=sqlite+aiosqlite:///./data/debug/llm_traces.db

# OpenAI key. Do not commit a real value. The debug page reports whether this is set.
OPENAI_API_KEY=

POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexusai

# Required by later milestones. Leave unset until that milestone.
# NEXUS_JWT_SECRET=local-nexusai-change-me
# Password for the LiteLLM proxy. Required when NEXUS_CHAT_API_BASE points at it.
# LITELLM_MASTER_KEY=
# OpenFGA HTTP API. Compose listens on 8090 and publishes that same port.
# The Playground is http://localhost:3000/playground. Host 8080 is the dashboard.
NEXUS_OPENFGA_API_URL=http://127.0.0.1:8090
NEXUS_OPENFGA_STORE_NAME=nexusai
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=nexusai
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# LANGSMITH_BASE_URL=https://eu.api.smith.langchain.com
# SEC_USER_AGENT=NexusAI Research you@example.com
# KAGGLE_USERNAME=
# KAGGLE_KEY=
