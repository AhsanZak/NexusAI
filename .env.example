# Local development defaults. Copy to .env when you need to override them.
# Never commit .env. The values below are local placeholders, not production secrets.

NEXUS_ENVIRONMENT=local
NEXUS_LOG_LEVEL=INFO
NEXUS_DATABASE_URL=postgresql+asyncpg://nexus:nexus@postgres:5432/nexusai
NEXUS_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus
POSTGRES_DB=nexusai

# Required by later milestones. Leave unset until that milestone.
# NEXUS_JWT_SECRET=
# LITELLM_MASTER_KEY=
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=nexusai
# SEC_USER_AGENT=NexusAI Research you@example.com
# KAGGLE_USERNAME=
# KAGGLE_KEY=
